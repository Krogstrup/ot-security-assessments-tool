# Runtime configuration for kusanaginokajiki_web package.
# Copy this file to config/app.env inside the extracted release bundle and edit as needed.

# Bind address and port
KK_HOST=0.0.0.0
KK_PORT=4173

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# Optional overrides (leave commented unless you need custom paths).
# Use absolute paths for portability when overriding.
# KK_FRONTEND_DIST=/opt/kusanaginokajiki/frontend
# KK_SIGNATURES_DIR=/opt/kusanaginokajiki/resources/signatures
# KK_DATA_DIR=/opt/kusanaginokajiki/resources/data
# KK_STATE_HOME=/opt/kusanaginokajiki/var/home
# KK_HEADLESS_IMPORTS_ROOT=/opt/kusanaginokajiki/var/imports
# KK_HEADLESS_EXPORT_DIR=/opt/kusanaginokajiki/var/export

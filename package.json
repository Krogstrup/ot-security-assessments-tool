{
  "name": "kusanaginokajiki",
  "version": "0.1.0",
  "description": "Modern ICS/SCADA passive network discovery tool — successor to NSA GRASSMARLIN",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "preview": "vite preview",
    "web:dev": "vite dev",
    "web:start": "cargo run --manifest-path src-tauri/Cargo.toml --bin kusanaginokajiki_web --",
    "web:build": "vite build && cargo build --manifest-path src-tauri/Cargo.toml --bin kusanaginokajiki_web --release",
    "web": "concurrently -n frontend,backend -c cyan,yellow \"npm run web:dev\" \"npm run web:start\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.3.0",
    "concurrently": "^9.2.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/state": "^6.5.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.13",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.30.0",
    "cytoscape-fcose": "^2.2.0",
    "zod": "^4.3.6"
  }
}
